# ============================================
# Hotel Management System — Environment Config
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the actual .env file to git!
# ============================================

# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster> with your Atlas credentials
MONGO_CONNECT=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Hotel_DB?retryWrites=true&w=majority

# JWT secret for signing authentication tokens
# Generate a secure random string:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Server port (optional, defaults to 5000)
PORT=5000
